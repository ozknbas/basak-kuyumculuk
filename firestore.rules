rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fırsat ürünleri koleksiyonu
    match /firsatUrunleri/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ad', 'gram', 'fiyat', 'resim', 'createdAt'])
                    && request.resource.data.ad is string
                    && request.resource.data.gram is number
                    && request.resource.data.fiyat is number
                    && request.resource.data.resim is string
                    && request.resource.data.resim.size() < 400000;
      allow delete: if true;
      allow update: if true;
    }

    // Ayarlar koleksiyonu (fiyat çarpanları, oranlar)
    match /ayarlar/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Eski / alternatif koleksiyonlar için geriye dönük uyumluluk
    match /bunlar/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /firsatProducts/{docId} {
      allow read, write: if true;
    }

    // Genel fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
